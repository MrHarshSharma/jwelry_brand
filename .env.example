# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Public site URL, used in WhatsApp messages to link back to the order
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Meta WhatsApp Cloud API (developers.facebook.com → WhatsApp → API Setup).
# When set, the store's admin number gets a template message for every new order,
# and customers get a template message when their order status changes.
# Leave blank to use click-to-chat (wa.me) links only.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v25.0
# Approved template names (body parameters are listed in README.md)
WHATSAPP_TEMPLATE_NEW_ORDER=new_order_alert
WHATSAPP_TEMPLATE_STATUS_UPDATE=order_status_update
WHATSAPP_TEMPLATE_LANGUAGE=en
